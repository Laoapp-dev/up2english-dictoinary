# ─────────────────────────────────────────────────────────────────────────────
# Local development only. Do NOT commit a real .env file (it's already
# git-ignored). For GitHub Pages deployment, these are supplied as
# GitHub Actions repository secrets instead — see README.md.
# ─────────────────────────────────────────────────────────────────────────────

# Merriam-Webster Collegiate Dictionary API key.
# Get a free key at https://dictionaryapi.com/register/index
VITE_MW_DICT_KEY="YOUR_MERRIAM_WEBSTER_DICTIONARY_KEY"

# Merriam-Webster Collegiate Thesaurus API key (optional — enables synonyms/antonyms).
# Register a second, separate app at https://dictionaryapi.com/register/index
VITE_MW_THESAURUS_KEY="YOUR_MERRIAM_WEBSTER_THESAURUS_KEY"

# Google Cloud Text-to-Speech API key (optional — higher quality pronunciation audio
# than the browser's built-in speech synthesis, used when a dictionary source has no
# audio file of its own). Create a key at https://console.cloud.google.com/apis/credentials
# after enabling the "Cloud Text-to-Speech API" on your Google Cloud project.
VITE_GOOGLE_TTS_API_KEY="YOUR_GOOGLE_CLOUD_TTS_KEY"
